/dts-v1/;
#include "sun8i-b288.dtsi"
#include "sunxi-common-regulators.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "PocketBook 618";
	compatible = "pocketbook,pb-618", "allwinner,sun8i-b288";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led {
			gpios = <&pio 6 9 GPIO_ACTIVE_LOW>; /* PG9 */
			default-state = "on";
		};
	};
};

&i2c0 {
	status = "okay";

	axp22x: pmic@34 {
		compatible = "x-powers,axp221";
		reg = <0x34>;
		interrupt-parent = <&r_intc>;
		interrupts = <0 0 IRQ_TYPE_LEVEL_LOW>;
	};
};

#include "axp22x.dtsi"

&reg_dldo2 {
	regulator-always-on;
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
	regulator-name = "vcc-sdcv";
};

&reg_dcdc1 {
	regulator-always-on;
	regulator-min-microvolt = <1003000>;
	regulator-max-microvolt = <1003000>;
	regulator-name = "vcc-emmcv-p3";
};

&reg_dldo1 {
	regulator-always-on;
	regulator-min-microvolt = <1001800>;
	regulator-max-microvolt = <1001800>;
	regulator-name = "vcc-emmcvq18-p3";
};

&mmc0 {
	vmmc-supply = <&reg_dldo2>;
	bus-width = <4>;
	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
	status = "okay";
};

&mmc1 {
	vmmc-supply = <&reg_vcc3v3>;
	bus-width = <4>;
	non-removable;
	status = "okay";

	/*
	 * Explicitly define the sdio device, so that we can add an ethernet
	 * alias for it (which e.g. makes u-boot set a mac-address).
	 */
	rtl8189: wifi@1 {
		reg = <1>;
	};
};

&mmc2 {
	vmmc-supply = <&reg_dcdc1>;
	vqmmc-supply = <&reg_dldo1>;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	non-removable;
	status = "okay";
};

&reg_usb1_vbus {
	gpio = <&pio 6 13 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};
